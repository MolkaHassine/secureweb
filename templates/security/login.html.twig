{% extends 'base.html.twig' %}

{% block title %}Connexion - SecureWeb{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>🛡️ SecureWeb</h1>
            <p>Connexion sécurisée</p>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}" class="auth-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="username">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>

            <div class="form-check">
                <input type="checkbox" name="_remember_me" id="remember_me" checked>
                <label for="remember_me">Se souvenir de moi</label>
            </div>

            <button class="btn btn-primary" type="submit">Se connecter</button>
        </form>

        <div class="auth-footer">
            <p>Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
        </div>
    </div>
</div>
{% endblock %}
